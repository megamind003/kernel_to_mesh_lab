# Database Configuration
DATABASE_URL=postgresql://panopticon:panopticon@localhost:5432/panopticon
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Performance Tuning
MAX_CONCURRENT_TRANSACTIONS=5000
REQUEST_TIMEOUT_MS=200
DB_STATEMENT_TIMEOUT_MS=100

# ML Model
ML_MODEL_PATH=./models/fraud_detector.onnx
FEATURE_CACHE_TTL_SECONDS=300

# Testing
STRESS_TEST_USERS=5000
STRESS_TEST_SPAWN_RATE=100
STRESS_TEST_DURATION=300
